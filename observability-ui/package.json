{
  "name": "@stacklenzz/ui",
  "version": "1.0.0",
  "description": "Stacklenzz developer-first React dashboard component library for backend observability",
  "author": "Goodnews Azonubi <azonubigoodnews@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideateGudy/stacklenzz.git",
    "directory": "observability-ui"
  },
  "bugs": {
    "url": "https://github.com/ideateGudy/stacklenzz/issues"
  },
  "homepage": "https://github.com/ideateGudy/stacklenzz/tree/main/observability-ui#readme",
  "license": "Apache-2.0",
  "keywords": [
    "observability",
    "dashboard",
    "react",
    "metrics",
    "monitoring",
    "telemetry",
    "nextjs",
    "express",
    "nestjs"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || ^19.0.0",
    "react-dom": ">=18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.46.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "latest",
    "typescript": "^7.0.2"
  }
}
