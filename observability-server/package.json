{
  "name": "@stacklenzz/server",
  "version": "1.0.0",
  "description": "Stacklenzz Observability SDK for Express and NestJS with OpenTelemetry, Prometheus metrics, and Winston logging",
  "author": "Goodnews Azonubi <azonubigoodnews@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideateGudy/stacklenzz.git",
    "directory": "observability-server"
  },
  "bugs": {
    "url": "https://github.com/ideateGudy/stacklenzz/issues"
  },
  "homepage": "https://github.com/ideateGudy/stacklenzz/tree/main/observability-server#readme",
  "license": "Apache-2.0",
  "keywords": [
    "observability",
    "opentelemetry",
    "prometheus",
    "winston",
    "express",
    "nestjs",
    "metrics",
    "tracing",
    "monitoring"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.mjs",
  "types": "./dist/core/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs",
      "require": "./dist/config/index.cjs"
    },
    "./express": {
      "types": "./dist/express/index.d.mts",
      "import": "./dist/express/index.mjs",
      "require": "./dist/express/index.cjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.mts",
      "import": "./dist/nestjs/index.mjs",
      "require": "./dist/nestjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prometheus-io/client": "^0.16.1",
    "winston": "^3.19.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "@nestjs/core": ">=9.0.0",
    "express": ">=4.18.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "tsdown": "latest",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
